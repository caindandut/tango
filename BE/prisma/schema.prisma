generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VocabularySet {
  id          String         @id @default(uuid())
  code        String?        @unique
  name        String
  level       String         @default("N3")
  unitNumber  Int?
  unitTitle   String         @default("")
  partNumber  Int            @default(1)
  partTitle   String         @default("")
  rangeStart  Int?
  rangeEnd    Int?
  isSummary   Boolean        @default(false)
  totalWords  Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vocabularies Vocabulary[]
  sessions    StudySession[]

  @@index([level, unitNumber, partNumber])
}

model Vocabulary {
  id        String        @id @default(uuid())
  position  Int           @default(0)
  kanji     String
  hiragana  String
  meaning        String
  hanVietMeaning String        @default("")
  examples       Json          @default("[]")
  relations      Json          @default("[]")
  sourceNumber   Int?
  setId     String
  set       VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  results   StudyResult[]

  @@index([setId])
  @@index([setId, sourceNumber])
}

model StudySession {
  id           String        @id @default(uuid())
  setId        String
  set          VocabularySet @relation(fields: [setId], references: [id], onDelete: Cascade)
  mode         String        @default("reading")
  totalWords   Int
  correctCount Int           @default(0)
  wrongCount   Int           @default(0)
  currentIndex Int           @default(0)
  roundStartIndex Int        @default(0)
  shuffledOrder Int[]
  quizOptions  Json?
  isCompleted  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  results      StudyResult[]

  @@index([setId])
}

model StudyResult {
  id         String       @id @default(uuid())
  sessionId  String
  session    StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vocabId    String
  vocabulary Vocabulary   @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  userAnswer String
  isCorrect  Boolean
  hintsUsed  Int          @default(0)
  answeredAt DateTime     @default(now())

  @@index([sessionId])
}
