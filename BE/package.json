{
  "name": "tango-be",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "npm run seed && node src/app.js",
    "seed": "node src/scripts/seedVocabulary.js",
    "validate:vocab": "node src/scripts/validateN3Vocabulary.js",
    "validate:n2": "node src/vocabulary/validateN2Vocabulary.js",
    "n2:extract": "node src/scripts/manualN2Review.js --mode=export",
    "n2:template": "node src/scripts/manualN2Review.js --mode=template",
    "n2:verify": "node src/scripts/manualN2Review.js --mode=verify",
    "n2:publish": "node src/scripts/publishN2Vocabulary.js",
    "validate:grammar": "node src/scripts/validateGrammarData.js",
    "grammar:review": "node src/scripts/reviewGrammarCurriculum.js",
    "grammar:publish": "node src/scripts/publishGrammarReview.js",
    "test": "node --test",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:deploy": "npx prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1"
  }
}
